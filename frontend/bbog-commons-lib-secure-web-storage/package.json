{
  "name": "bbog-commons-lib-secure-web-storage",
  "type": "module",
  "version": "0.1.0",
  "description": "Librería BBOG para cifrar/descifrar valores de localStorage y sessionStorage usando un fingerprint del dispositivo. Basada en @avaldigitallabs/adl-commons-lib-secure-web-storage.",
  "files": [
    "build"
  ],
  "main": "./build/bbog-commons-lib-secure-web-storage.cjs",
  "module": "./build/bbog-commons-lib-secure-web-storage.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/bbog-commons-lib-secure-web-storage.js",
      "require": "./build/bbog-commons-lib-secure-web-storage.cjs"
    }
  },
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^5.0.0"
  },
  "dependencies": {
    "@types/node-forge": "^1.3.11",
    "node-forge": "^1.3.1"
  }
}
